# Copy to .env and fill in ONLY the key for the provider selected by
# config.json -> "active_provider". The default provider (local_lmstudio)
# needs no key — just LM Studio running on http://127.0.0.1:1234.

GOOGLE_API_KEY=        # provider "gemini"
OPENAI_API_KEY=        # provider "openai"
ANTHROPIC_API_KEY=     # provider "anthropic"

# Optional: override config.json's active_provider for this run
# ACTIVE_PROVIDER=gemini

# Optional: DEBUG / INFO / WARNING (default INFO)
LOG_LEVEL=INFO
